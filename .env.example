OPENAI_MODEL=your-azure-deployment-name
OPENAI_API_KEY=
OPENAI_BASE_URL=https://your-resource.openai.azure.com
OPENAI_API_VERSION=2025-04-01-preview

EXA_API_KEY=
# Optional corporate certificate bundle and compatibility for legacy CA extensions.
EXA_CA_BUNDLE=
EXA_LEGACY_CA=0

# Gmail SMTP (uses the app password; account password is not used for SMTP)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional trusted corporate CA bundle / legacy CA compatibility
GMAIL_CA_BUNDLE=
GMAIL_LEGACY_CA=0
